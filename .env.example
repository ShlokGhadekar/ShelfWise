# Copy to .env (`cp .env.example .env`) and adjust. .env is git-ignored.

# --- Postgres (used by docker-compose AND by the Python code) ---
POSTGRES_USER=shelfwise
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=shelfwise
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Which slice of M5 to work on ---
# ALL           -> all 10 stores, 30,490 series (~59M rows in long format)
# CA            -> one state (4 stores, 12,196 series, ~24M rows)
# CA_1          -> one store (3,049 series, ~6M rows)  <- recommended while developing
# CA_1,TX_1     -> comma-separated list of states and/or stores
# Changing SUBSET makes the next run rebuild staging + features from scratch (automatic).
SUBSET=CA_1

# --- "Today" for the pipeline (last observed day, d_1 .. d_1941) ---
# Leave empty to use every day in the file. Set e.g. 1913 for the first run and
# then 1941 to demonstrate incremental loading of 28 new days.
LAST_DAY=

# Optional: point to a different config file
# SHELFWISE_CONFIG=config/config.yaml
